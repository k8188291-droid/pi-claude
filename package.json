{
  "name": "pi-claude-code-tools",
  "version": "0.1.0",
  "description": "Claude Code-compatible tools for pi coding agent (SDK use)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "default": "./dist/memory/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "parity": "tsx parity/run.ts",
    "parity:typecheck": "tsc -p parity/tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "glob": "^13.0.6",
    "typebox": "1.3.27",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@types/node": "^26.6.4",
    "diff": "^9.0.0",
    "just-bash": "3.6.0",
    "minimatch": "10.2.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "just-bash": "^3.4.2",
    "minimatch": "^10.2.5"
  },
  "peerDependenciesMeta": {
    "just-bash": {
      "optional": true
    },
    "minimatch": {
      "optional": true
    }
  }
}
